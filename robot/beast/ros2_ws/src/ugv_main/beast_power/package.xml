<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>beast_power</name>
  <version>0.1.0</version>
  <description>
    BEAST-01 driver-board INA219 power telemetry: INA219 over I²C → honest
    sensor_msgs/BatteryState on /ugv/voltage and std_msgs/Bool on
    /ugv/charging_active. Vendored/adapted from LeoRover charging_monitor.
  </description>
  <maintainer email="pmaclyman@gmail.com">Coldaine</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
