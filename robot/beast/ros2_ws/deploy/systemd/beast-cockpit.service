# DISABLED BY DEFAULT, ON PURPOSE.
#
# Starting this unit opens a rosbridge websocket that can publish onto the
# robot's command topics. There is no authentication on it; the boundary is the
# loopback bind + the topic whitelist in ugv_cockpit/launch/rosbridge.launch.py
# + tailscale serve. `systemctl enable` is an operator decision, not part of
# installing the workspace.
#
# docs/cockpit.md has the whitelist, the commissioning check that proves it is
# enforced (denials are SILENT to the client), and the tailscale serve command.
# Port 9090 is loopback-only, so no firewall hole is needed or wanted.

[Unit]
Description=BEAST-01 Command Deck cockpit (OAK + rosbridge + cockpit nodes)
Wants=network-online.target beast-ros-base.service
After=network-online.target beast-ros-base.service
ConditionPathExists=/home/beast/beast/RobotOverview/robot/beast/ros2_ws/install/setup.bash

[Service]
Type=simple
User=beast
Group=beast
# No `dialout`: this unit never touches the ESP32 serial link. video/render/
# plugdev are for the OAK-D over USB. The bridge does admit the reviewed remote
# command topics, but this process needs no direct serial-device access.
SupplementaryGroups=video render plugdev
WorkingDirectory=/home/beast/beast/RobotOverview/robot/beast/ros2_ws
# COCKPIT_ALLOWED_ORIGINS lives here. It is the origin SERVING the cockpit page
# (the RobotOverview deployment), not this robot's hostname — the Origin header
# carries the page's origin. Unset denies every browser, on purpose: rosbridge's
# check_origin returns True unconditionally and WebSocket handshakes skip CORS,
# so without an allowlist any page in any tab on a tailnet-joined machine can
# publish to the reviewed command topics. docs/cockpit.md has the reasoning.
EnvironmentFile=/etc/beast/ugv.env
Environment=PYTHONUNBUFFERED=1
# Cockpit telemetry + camera + a reviewed remote command ingress through the
# existing mux/gate/watchdog path. No direct /cmd_vel or serial bypass.
# Same boot guard as beast-ros-base: the cockpit runs from the same
# --symlink-install workspace, so booting it mid-rebuild is the same
# half-built hazard. Wrapped in /bin/sh -c for systemd-analyze on CI runners.
ExecStartPre=/bin/sh -c 'exec /home/beast/beast/RobotOverview/robot/beast/ros2_ws/deploy/bin/beast-deploy-guard'
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/beast/beast/RobotOverview/robot/beast/ros2_ws/install/setup.bash && exec ros2 launch ugv_cockpit cockpit.launch.py use_camera:=true use_bridge:=true'
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
