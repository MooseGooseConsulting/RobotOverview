[Unit]
Description=BEAST-01 ROS 2 base bring-up (manual motion gate)
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/home/beast/beast/RobotOverview/robot/beast/ros2_ws/install/setup.bash

[Service]
Type=simple
User=beast
Group=beast
# i2c: beast_power reads the driver-board INA219 on /dev/i2c-7 (root:i2c).
SupplementaryGroups=dialout video render i2c audio
WorkingDirectory=/home/beast/beast/RobotOverview/robot/beast/ros2_ws
EnvironmentFile=/etc/beast/ugv.env
Environment=PYTHONUNBUFFERED=1
# Same session Pulse/speechd sockets as interactive user `beast`. Linger
# must be on so /run/user/1000 exists at boot without a login.
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Refuse to start into a workspace beast-pull is mid-way through rebuilding.
# Bounded by a staleness TTL inside the guard so a killed agent cannot brick
# boot permanently. Runs the tree copy, same pattern as beast-slam's ExecStop.
ExecStartPre=/home/beast/beast/RobotOverview/robot/beast/ros2_ws/deploy/bin/beast-deploy-guard
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/beast/beast/RobotOverview/robot/beast/ros2_ws/install/setup.bash && exec ros2 launch ugv_bringup bringup_lidar.launch.py use_lidar:=true use_rviz:=false allow_motion:=true'
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
