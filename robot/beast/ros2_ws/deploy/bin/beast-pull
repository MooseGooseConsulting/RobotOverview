#!/bin/bash
# BEAST-01 unattended source-mode deploy agent.
#
# Fetches the GATED deploy ref, rebuilds only what changed, restarts the stack,
# verifies it, and rolls back if verification fails. Runs hourly from
# beast-pull.timer as user `beast`, using only the systemctl verbs already
# allowlisted in /etc/sudoers.d/beast-ops. It needs no credentials: RobotOverview
# is public, so `git fetch` over HTTPS is anonymous.
#
# WHY A DEPLOY REF AND NOT origin/main
# ------------------------------------
# Fast-forwarding to main would deploy every merge the instant it lands, which
# bypasses the failing-tests gate in .github/workflows/deploy-pin.yml — the gate
# that exists so a red commit cannot reach a machine that moves. deploy-pin.yml
# force-updates refs/deploy/beast-01 only AFTER that gate passes, so this agent
# tracking that ref inherits the gate for free, and `git push --force
# refs/deploy/beast-01@{1}` is a one-command rollback for the whole fleet.
#
# THE INCONSISTENCY WINDOW AND HOW IT IS HELD SHUT
# ------------------------------------------------
# install/ is a --symlink-install tree, so moving the checkout swaps the Python
# and launch layers immediately; there is no candidate / atomic-swap step the
# way a container deploy would have. Between checkout and a finished build the
# workspace is inconsistent. Three rules keep anything from running inside that
# window:
#   * the stack is STOPPED before the checkout moves and started only after the
#     build finishes, so no live interpreter can lazily import mixed code;
#   * an in-progress marker exists exactly for the checkout->build window, and
#     beast-deploy-guard makes beast-ros-base refuse to boot while it exists —
#     a power cut mid-deploy leaves the robot STOPPED, not running a half-built
#     stack;
#   * if the marker survives a hard kill, the next timer tick detects it and
#     rebuilds before considering anything else (recovery mode below).
#
# HOLDS
#   /etc/beast/pull-hold        operator kill switch (root-owned; we only read it)
#   /data/beast/deploy/pull-hold  self-hold, set when even the rollback failed
#
# Exit codes: 0 nothing to do or deployed+verified; 1 failure (rolled back or
# held); never a partial success that reports zero.
set -uo pipefail

REPO_DIR="${BEAST_REPO_DIR:-/home/beast/beast/RobotOverview}"
WS_DIR="$REPO_DIR/robot/beast/ros2_ws"
DEPLOY_REF="${BEAST_DEPLOY_REF:-refs/deploy/beast-01}"
STATE_DIR="${BEAST_STATE_DIR:-/data/beast/deploy}"
OPERATOR_HOLD="/etc/beast/pull-hold"
SELF_HOLD="$STATE_DIR/pull-hold"
IN_PROGRESS="$STATE_DIR/in-progress"
STATE_FILE="$STATE_DIR/pull-state.json"
LAST_GOOD="$STATE_DIR/last-good-sha"
FAILED_TARGET="$STATE_DIR/failed-target"
RECOVERY_COUNT="$STATE_DIR/recovery-attempts"

# Hard ceiling on one colcon invocation. Without it, a build that outlives
# beast-pull.service's TimeoutStartSec is killed by systemd INSIDE the marker
# window — and recovery would rerun the identical build into the identical
# kill, hourly, forever, with the stack down and nothing escalating. A timeout
# HERE returns through the normal failure path instead: rollback, then
# self-hold if that fails too. The service timeout is sized to fit two of
# these plus overhead.
BUILD_TIMEOUT_SECONDS="${BEAST_BUILD_TIMEOUT:-1200}"

# Always rebuilt regardless of the diff: these four are the boot path, and
# rebuilding them is cheap next to being wrong about them. Matches
# deploy-to-beast.sh's default --packages-select set.
ALWAYS_PACKAGES="beast_power beast_base ugv_bringup ugv_cockpit"

# Motion is "any |linear.x| or |angular.z| above this on /cmd_vel".
MOTION_EPS="0.01"
MOTION_SAMPLE_SECONDS=6

log() { printf '%s beast-pull: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }
die() { log "FAIL $*"; exit 1; }

# ------------------------------------------------ which packages changed ----
# Map changed paths under src/ back to the package that owns them (nearest
# ancestor holding a package.xml), then union with ALWAYS_PACKAGES.
#
# Resolved against the TARGET git tree, not the filesystem: this runs before
# the checkout moves, so a package the target commit ADDS has no package.xml on
# disk yet — a filesystem walk would silently skip it and the deploy would
# "succeed" without ever building it. Deletions fall out the same way: a path
# whose package no longer exists in the target resolves to nothing.
#
# Parked packages must be excluded — colcon errors out on a selected package it
# cannot discover — and parking is a COLCON_IGNORE at ANY ancestor level: the
# five vizanti packages share one marker at src/ugv_else/vizanti/. So the walk
# keeps climbing after finding package.xml, and an ignore anywhere on the way
# up drops the package.
#
# Rebuilding only the four default packages is what lets a stale compiled
# artefact sit beside a newly symlinked source file and still look deployed.
changed_packages() {
  local from="$1" to="$2" dir name paths
  # --no-renames: with rename detection on, a file moved between packages
  # emits only its DESTINATION path, so the source package silently keeps its
  # stale artefacts — exactly how beast_base was once extracted from
  # ugv_bringup. quotePath off so a non-ASCII path is not C-quoted into a
  # string the prefix match below would drop.
  paths="$(git -c core.quotePath=false -C "$REPO_DIR" diff --no-renames --name-only "$from" "$to" \
      -- "robot/beast/ros2_ws/src")"
  [ -n "$paths" ] || return 0
  {
    printf '%s\n' "$paths" | sed 's|/[^/]*$||'
    # An added or removed COLCON_IGNORE re-scopes a whole SUBTREE, but the
    # diff names only the marker file — un-parking vizanti would otherwise
    # build none of its five nested packages. Enumerate the subtree's package
    # dirs from the target tree; the per-dir walk below still drops any that
    # remain parked at some level.
    printf '%s\n' "$paths" | grep '/COLCON_IGNORE$' | sed 's|/[^/]*$||' \
      | while IFS= read -r dir; do
          git -C "$REPO_DIR" ls-tree -r --name-only "$to" "$dir" 2>/dev/null \
            | grep '/package.xml$' | sed 's|/[^/]*$||'
        done
  } | sort -u \
    | while IFS= read -r dir; do
        name=""
        while case "$dir" in robot/beast/ros2_ws/src/?*) true ;; *) false ;; esac; do
          if git -C "$REPO_DIR" cat-file -e "$to:$dir/COLCON_IGNORE" 2>/dev/null; then
            name=""
            break
          fi
          if [ -z "$name" ] && git -C "$REPO_DIR" cat-file -e "$to:$dir/package.xml" 2>/dev/null; then
            # colcon selects by package NAME, which is the <name> tag, not the
            # directory. They match everywhere in this tree today; do not bake
            # that assumption in.
            name="$(git -C "$REPO_DIR" show "$to:$dir/package.xml" 2>/dev/null \
              | sed -n 's|.*<name>\(.*\)</name>.*|\1|p' | head -1)"
            [ -n "$name" ] || name="${dir##*/}"
          fi
          dir="${dir%/*}"
        done
        [ -n "$name" ] && printf '%s\n' "$name"
      done
}

build_set() {
  { changed_packages "$1" "$2"; printf '%s\n' $ALWAYS_PACKAGES; } | sort -u | tr '\n' ' '
}

# Dry run: "what would a deploy from A to B rebuild?" No holds, no fetch, no
# side effects. Exists so the mapping above is testable off-robot, and so an
# operator can ask the question before letting the timer answer it.
if [ "${1:-}" = "--print-build-set" ]; then
  build_set "${2:?usage: beast-pull --print-build-set <from> <to>}" \
            "${3:?usage: beast-pull --print-build-set <from> <to>}"
  exit 0
fi

# ---------------------------------------------------------------- holds ----
if [ -e "$OPERATOR_HOLD" ]; then
  log "operator hold present ($OPERATOR_HOLD); doing nothing"
  exit 0
fi
if [ -e "$SELF_HOLD" ]; then
  log "self-hold present ($SELF_HOLD) — a previous rollback failed to verify."
  if [ -e "$IN_PROGRESS" ]; then
    log "the in-progress marker is ALSO present ($IN_PROGRESS): the last failure was"
    log "mid-build, so beast-deploy-guard is holding beast-ros-base down. Remove BOTH"
    log "files after investigating — clearing only the self-hold leaves boot blocked."
  else
    log "Investigate, then remove the file to re-enable automatic deploys."
  fi
  exit 0
fi

mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"

# ------------------------------------------------------ beast-ctl gate ----
# Every unit operation below goes through sudo -n /usr/local/sbin/beast-ctl.
# Prove that path works BEFORE anything destructive, because the first thing
# checkout_build_restart does is stop beast-ros-base — and if the privilege
# path is broken, the stop fails, the rollback leg calls the same broken
# command, and an unattended tick ends in a self-hold with the stack down.
#
# Two ways it breaks in practice, both during rollout: /usr/local/sbin/beast-ctl
# is not installed yet, or the robot still carries the pre-beast-ctl sudoers
# that never named it. `beast-ctl policy` is the right probe — it touches no
# systemd, mutates nothing, and exits 0 iff the binary is present at the
# root-owned path AND sudoers grants it passwordlessly. Exiting 0 here (not
# die) is deliberate: a robot mid-migration should idle until the operator
# lands the new sudoers, not burn its recovery budget once an hour.
if ! sudo -n /usr/local/sbin/beast-ctl policy >/dev/null 2>&1; then
  log "sudo -n /usr/local/sbin/beast-ctl is unavailable; refusing to deploy."
  log "The robot is mid-migration: install the wrapper + sudoers with"
  log "  sudo $WS_DIR/deploy/bin/install-beast-sudoers.sh"
  log "Nothing was stopped or checked out. Retrying next tick."
  exit 0
fi

# ------------------------------------------------------------ ros setup ----
# ROS setup scripts reference unbound vars (AMENT_TRACE_SETUP_FILES et al.),
# so -u must actually be OFF while sourcing — under set -u the first source
# aborts the whole agent before it reads a single topic. Every other script
# in deploy/bin already sources before enabling -u; this one enables it at
# the top, so drop and restore it around the sources.
set +u
# shellcheck disable=SC1091
source /opt/ros/humble/setup.bash
# shellcheck disable=SC1091
source "$WS_DIR/install/setup.bash" 2>/dev/null || true
set -u

# The gate's topic reads below are late-joining CLI participants — exactly the
# class of reader the default SHM transport and a stale per-user daemon break
# on this host. Observed live 2026-08-14: the pre-NTP boot clock jump left the
# ros2 daemon answering every graph query with `!rclpy.ok()`, so the gate read
# zero samples and failed closed on EVERY tick — safe, but the robot silently
# stops following the deploy ref, forever, with nothing escalating. Same
# remedy beast-verify already uses: UDP-only profile, drop any stale daemon,
# and warm a fresh one before the timed reads.
cat > "$STATE_DIR/fastdds-udp.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
XML
export FASTRTPS_DEFAULT_PROFILES_FILE="$STATE_DIR/fastdds-udp.xml"
ros2 daemon stop >/dev/null 2>&1 || true
ros2 topic list >/dev/null 2>&1 || true

# ------------------------------------------------------- the parked gate ----
# The plan's original spec said "skip while /ugv/allow_motion is true". That gate
# would never open: beast_base declares allow_motion defaulting to True and
# beast-ros-base launches with allow_motion:=true, so the robot is ARMED AT REST
# by design. Armed-and-idle is the normal state and is safe to deploy into.
# Gate on actual motion instead — from BOTH ends of the drive path:
#   * /cmd_vel catches an actively commanding driver;
#   * /odom_wheel (measured wheel feedback via odom_publisher) catches the case
#     command silence cannot rule out: the ESP32 has no cmd_vel watchdog since
#     2026-08-07 and latches its last command, so wheels can be turning while
#     nothing publishes. Silence on the command topic is not proof of stillness;
#     silence from the wheels is.
# RESIDUAL, named: with the stack DOWN both topics are silent, so the gate
# reads "parked" in exactly the state where a latched ESP32 command is
# unobservable. That needs beast_base hard-killed mid-drive AND nobody
# noticing a headless runaway for up to an hour; beast_base sends its
# unconditional stop the moment the stack comes back up.
MOTION_SOURCE=""
MOTION_SAMPLES_SEEN=0
is_moving() {
  local sample
  sample="$(timeout "$MOTION_SAMPLE_SECONDS" ros2 topic echo /cmd_vel 2>/dev/null)"
  if [ -n "$sample" ]; then
    MOTION_SAMPLES_SEEN=1
    printf '%s\n' "$sample" \
      | awk -v eps="$MOTION_EPS" '
          /^[[:space:]]*x:/ || /^[[:space:]]*z:/ {
            v = $2 + 0; if (v < 0) v = -v;
            if (v > eps) { found = 1 }
          }
          END { exit(found ? 0 : 1) }' && { MOTION_SOURCE="/cmd_vel (commanded)"; return 0; }
  fi
  # Odometry frames also carry pose (which grows without bound), so only the
  # twist section counts, and the flag resets at each `---` message boundary.
  sample="$(timeout "$MOTION_SAMPLE_SECONDS" ros2 topic echo /odom_wheel 2>/dev/null)"
  if [ -n "$sample" ]; then
    MOTION_SAMPLES_SEEN=1
    printf '%s\n' "$sample" \
      | awk -v eps="$MOTION_EPS" '
          /^---/    { in_twist = 0 }
          /^twist:/ { in_twist = 1 }
          in_twist && (/^[[:space:]]*x:/ || /^[[:space:]]*z:/) {
            v = $2 + 0; if (v < 0) v = -v;
            if (v > eps) { found = 1 }
          }
          END { exit(found ? 0 : 1) }' && { MOTION_SOURCE="/odom_wheel (measured — possible latched command)"; return 0; }
  fi
  return 1
}

if is_moving; then
  log "robot is moving: non-zero $MOTION_SOURCE within ${MOTION_SAMPLE_SECONDS}s; skipping, will retry next tick"
  exit 0
fi
# Zero samples with a RUNNING base is a sampling failure, not stillness —
# odom_publisher publishes continuously, so silence there means our echo lost
# the DDS discovery race (or worse). Fail closed and retry next tick. A base
# that is DOWN is different: no topics can exist, nothing new can command the
# motors, and the deploy itself is what restores the stack and fires
# beast_base's unconditional boot stop — skipping would help nothing.
if [ "$MOTION_SAMPLES_SEEN" = 0 ] && systemctl is-active --quiet beast-ros-base; then
  # Even a freshly warmed daemon can lose the discovery race inside a single
  # sample window right after it spawns; give it one settled retry before
  # concluding the graph is unreadable.
  log "no motion samples on the first pass with base active; retrying once"
  sleep 5
  if is_moving; then
    log "robot is moving: non-zero $MOTION_SOURCE within ${MOTION_SAMPLE_SECONDS}s; skipping, will retry next tick"
    exit 0
  fi
  if [ "$MOTION_SAMPLES_SEEN" = 0 ]; then
    log "beast-ros-base is active but neither /cmd_vel nor /odom_wheel produced a sample after a retry; cannot rule out motion — skipping, will retry next tick"
    exit 0
  fi
fi
if systemctl list-units --state=active --no-legend 'beast-mission-record@*' 2>/dev/null | grep -q .; then
  log "a mission recording is active; skipping, will retry next tick"
  exit 0
fi

# ------------------------------------------------------------ recovery ----
# A marker that exists BEFORE we have touched anything means a previous run was
# killed between checkout and build (power cut, SIGKILL, systemd timeout). The
# workspace cannot be trusted and beast-deploy-guard is holding the stack down.
# Do not skip the deploy even if HEAD already equals the target — rebuild it.
recovering=0
if [ -e "$IN_PROGRESS" ]; then
  recovering=1
  log "in-progress marker found: a previous deploy was interrupted mid-build; recovering"
else
  # No marker means no interrupted deploy: drop any stale counter (e.g. a
  # marker an operator removed by hand) so a future recovery starts at 1.
  rm -f "$RECOVERY_COUNT"
fi

# --------------------------------------------------------------- fetch ----
git -C "$REPO_DIR" fetch --prune --quiet origin "+$DEPLOY_REF:$DEPLOY_REF" \
  || die "cannot fetch $DEPLOY_REF from origin"

target="$(git -C "$REPO_DIR" rev-parse --verify "$DEPLOY_REF^{commit}" 2>/dev/null)" \
  || die "$DEPLOY_REF does not resolve to a commit"
current="$(git -C "$REPO_DIR" rev-parse HEAD)"

# Escalate instead of looping: if recovery itself keeps dying (build always
# hits its timeout, disk full), the same rebuild would rerun hourly forever
# with the stack down and nothing telling anyone. Three strikes -> self-hold,
# loudly, with the marker left in place so the guard keeps boot parked.
# Counted HERE, after the fetch — a merely-offline robot dying on "cannot
# fetch" is not a rebuild failure, and burning the budget on it would
# self-hold with a message blaming the build. The bump still lands on disk
# BEFORE the rebuild, so a SIGKILL mid-build finds it next tick.
if [ "$recovering" = 1 ]; then
  attempt="$(cat "$RECOVERY_COUNT" 2>/dev/null || echo 0)"
  attempt=$((attempt + 1))
  printf '%s\n' "$attempt" > "$RECOVERY_COUNT"
  if [ "$attempt" -ge 3 ]; then
    : > "$SELF_HOLD"
    log "FAIL recovery attempt $attempt — the same rebuild keeps dying the same way (build timeout? disk?)."
    log "Set $SELF_HOLD; the marker stays and beast-deploy-guard keeps the stack down."
    log "Investigate, then remove both $SELF_HOLD and $IN_PROGRESS."
    exit 1
  fi
  log "recovery attempt $attempt of 3"
fi

if [ "$target" = "$current" ] && [ "$recovering" = 0 ]; then
  # "Already at target" is only a no-op if the stack is actually UP. A kill
  # between "marker removed" (build done) and "restart issued" leaves
  # HEAD == target with no marker and beast-ros-base stopped — and without
  # this check every subsequent tick would shrug "nothing to do" at a robot
  # that is down. An operator-disabled base (inactive AND disabled, the
  # beast-cockpit convention) is respected and left alone.
  if systemctl is-active --quiet beast-ros-base; then
    log "already at ${target:0:12}; nothing to do"
    exit 0
  fi
  if [ "$(systemctl is-enabled beast-ros-base 2>/dev/null)" = "disabled" ]; then
    log "already at ${target:0:12}; beast-ros-base is operator-disabled — leaving it alone"
    exit 0
  fi
  log "at ${target:0:12} but beast-ros-base is not running (deploy interrupted between build and restart?); redeploying to restore it"
fi
[ "$recovering" = 0 ] && [ "$target" != "$current" ] && log "deploy ref moved: ${current:0:12} -> ${target:0:12}"

# A target that failed on-robot once will fail again until something changes,
# and CI cannot see on-robot failures (i2c, serial, live-graph checks). Without
# this memory the agent would stop/build/restart/verify/roll back the SAME bad
# commit every hour — the stack down twice a tick, indefinitely. Cleared when
# the ref moves; rm the file to force a retry of the same sha.
if [ "$recovering" = 0 ] && [ -f "$FAILED_TARGET" ]; then
  if [ "$(cat "$FAILED_TARGET" 2>/dev/null)" = "$target" ]; then
    log "target ${target:0:12} already failed on-robot once; holding until $DEPLOY_REF moves (rm $FAILED_TARGET to retry)"
    exit 0
  fi
  rm -f "$FAILED_TARGET"
fi

# Tracked-file modifications mean a human is mid-something. Untracked files are
# normal on this robot (slam / telemetry leftovers) and are left alone.
# EXCEPT while recovering: a kill during the previous run's checkout leaves
# OUR OWN half-moved files behind, and refusing to touch them would strand the
# robot — marker up, guard holding boot down, and every tick dying right here.
# The marker is proof the dirt is the agent's; recovery checkouts run --force.
if [ "$recovering" = 0 ] && [ -n "$(git -C "$REPO_DIR" status --porcelain --untracked-files=no)" ]; then
  die "on-robot tree has modified tracked files; refusing to deploy over them"
fi

# When recovering, HEAD is suspect — the last KNOWN-GOOD sha is the rollback
# point, and the build span must start there so the interrupted build's
# packages are definitely in the set. Never overwrite LAST_GOOD with a sha
# that was mid-deploy when the lights went out.
# Validated, not trusted: a power cut during the write below can leave
# LAST_GOOD empty, and an empty rollback point would corrupt every git call
# that consumes it. An unusable file falls back to HEAD.
rollback_sha=""
if [ "$recovering" = 1 ] && [ -f "$LAST_GOOD" ]; then
  rollback_sha="$(git -C "$REPO_DIR" rev-parse --verify \
    "$(cat "$LAST_GOOD")^{commit}" 2>/dev/null)" || rollback_sha=""
fi
[ -n "$rollback_sha" ] || rollback_sha="$current"
[ "$recovering" = 0 ] && printf '%s\n' "$current" > "$LAST_GOOD"

packages="$(build_set "$rollback_sha" "$target")"
log "build set: $packages"

# Pin ONE verify script for this whole session, forward and rollback runs
# alike. The checkout moves during a deploy, so "the verify on disk" is a
# moving target — and a rollback across the commit that INTRODUCED beast-verify
# (or a fleet rollback to a commit before it) would otherwise fail on a file
# that no longer exists, turning a clean rollback into a self-hold. Prefer the
# target tree's copy (the contract being deployed); fall back to the current
# checkout's.
SESSION_VERIFY="$STATE_DIR/session-verify.sh"
if ! git -C "$REPO_DIR" show "$target:robot/beast/ros2_ws/deploy/bin/beast-verify" \
    > "$SESSION_VERIFY" 2>/dev/null || ! [ -s "$SESSION_VERIFY" ]; then
  if [ -f "$WS_DIR/deploy/bin/beast-verify" ]; then
    cp "$WS_DIR/deploy/bin/beast-verify" "$SESSION_VERIFY"
  else
    die "no beast-verify in the target tree or the current checkout"
  fi
fi

# Host-side systemd payloads are part of the deploy too: unit files that change
# in this span must be reinstalled (in EITHER direction — a rollback of a unit
# change needs the old files back), or the robot restarts into stale unit
# definitions while pull-state.json records the new SHA as live. The installer
# reads deploy/systemd/ from the CHECKOUT, so it must run after checkout.
units_changed=0
if ! git -C "$REPO_DIR" diff --quiet "$rollback_sha" "$target" \
    -- "robot/beast/ros2_ws/deploy/systemd" 2>/dev/null; then
  units_changed=1
  log "systemd unit files changed in this span; will reinstall via beast-install-systemd-units"
fi

if [ "$recovering" = 1 ]; then
  # The interrupted run recorded its own target and package set in the marker.
  # Recovery must rebuild AT LEAST those packages: the ref may have moved since
  # (a fleet rollback via force-push is the everyday case), which can shrink
  # the freshly computed span right out from under the half-built packages —
  # leaving A-era artefacts under an X-era tree that then "verifies".
  interrupted_pkgs="$(cut -d' ' -f2- < "$IN_PROGRESS" 2>/dev/null || true)"
  if [ -n "$interrupted_pkgs" ]; then
    packages="$(printf '%s\n' $packages $interrupted_pkgs | sort -u | tr '\n' ' ')"
    log "recovery build set (union with interrupted run): $packages"
  fi
  # The interrupted run may already have installed ITS target's unit files;
  # reinstall unconditionally so units match whatever tree recovery lands on.
  units_changed=1
fi

# ------------------------------------------------------------- deploy ----
checkout_build_restart() {
  local sha="$1" pkgs="$2" available selected p f force_flag

  # Stop the stack before moving a --symlink-install workspace under it. The
  # motion gate proved the robot is parked, so a stopped base is a safe state,
  # and a stopped process cannot lazily import half-rebuilt code. The cockpit
  # shares the same workspace, so it gets the same treatment — but only if it
  # was running: an operator-disabled cockpit stays down, per its convention.
  # cockpit_active is session-scoped and probed ONCE, before the forward call:
  # probing here would make the rollback leg read the cockpit the FORWARD leg
  # just stopped as "inactive", skip its restart, and beast-verify would then
  # fail an otherwise clean rollback into a self-hold with the UI down.
  sudo -n /usr/local/sbin/beast-ctl stop beast-ros-base || return 1
  if [ "$cockpit_active" = 1 ]; then
    sudo -n /usr/local/sbin/beast-ctl stop beast-cockpit || return 1
  fi
  # beast-nav shares this workspace but is a hand-started supervised unit: a
  # nav session momentarily stationary passes the motion gate, and a live
  # bt_navigator surviving the swap would resume commanding motion into a
  # freshly rebuilt stack the moment base returns. Stop it unconditionally,
  # tolerate absence/failure (the unit may not be installed yet), and NEVER
  # restart it below — deploys leave nav DOWN by design; the owner starts it
  # again by hand.
  log "stopping beast-nav (never survives a workspace swap; deploys leave nav down)"
  sudo -n /usr/local/sbin/beast-ctl stop beast-nav \
    || log "beast-nav stop failed or unit absent; continuing"

  # The marker's lifetime IS the inconsistency window: created just before the
  # checkout moves, removed only after the build finishes. While it exists,
  # beast-deploy-guard refuses to boot the stack. Not earlier (a failed stop
  # would leave a marker guarding a perfectly consistent workspace) and it
  # must NOT span the restart below, or the guard would reject this agent's
  # own deploy. The payload — this run's target and package set — is what a
  # future recovery rebuilds, so a killed run's work is never lost to a
  # deploy ref that moved in the meantime.
  printf '%s %s\n' "$sha" "$pkgs" > "$IN_PROGRESS"

  # An untracked file sitting at a path the target commit ADDS makes
  # `git checkout` refuse outright — and this window (stack stopped, marker
  # written) is the worst possible place to die. deploy-to-beast.sh has
  # carried this exact sweep since it bit a manual deploy. Deleting only
  # untracked files at target-added paths is the same rule that lets
  # untracked leftovers exist here at all: they are expendable.
  git -C "$REPO_DIR" diff --name-only --diff-filter=A HEAD "$sha" 2>/dev/null \
    | while IFS= read -r f; do
        [ -n "$f" ] && [ -e "$REPO_DIR/$f" ] \
          && ! git -C "$REPO_DIR" ls-files --error-unmatch "$f" >/dev/null 2>&1 \
          && rm -f "$REPO_DIR/$f"
      done

  # Detached on purpose. deploy-to-beast.sh names the robot's branch after the
  # DEPLOYING WORKSTATION's branch, which is how the robot ended up sitting on a
  # branch called claude/plan-review-fixes. A deploy agent owns no branch name.
  # --force only while recovering: the dirty-tree guard was skipped because the
  # dirt is the interrupted run's own half-moved checkout, and a plain checkout
  # would refuse it all over again.
  force_flag=""
  [ "$recovering" = 1 ] && force_flag="--force"
  git -C "$REPO_DIR" checkout --quiet --detach $force_flag "$sha" || return 1
  [ "$(git -C "$REPO_DIR" rev-parse HEAD)" = "$sha" ] || return 1

  # Filter the requested set against what colcon can actually discover in THIS
  # tree. The set was resolved against the target; the rollback tree (or a
  # recovery union) can name packages that do not exist here — added by the
  # target, deleted by it, or renamed — and colcon must not be handed a
  # selection it cannot resolve. Dropping them is correct in every direction:
  # a package absent from this sha's tree has nothing to build at this sha.
  # No stderr suppression and no empty-tolerance: an empty or failing
  # `colcon list` here does not mean "no packages" — it means colcon itself is
  # broken, and pretending otherwise drops every package with a misleading
  # "does not exist at <sha>" line and fails the deploy AND its rollback the
  # same way, which is the permanent self-hold. Let colcon's own error reach
  # the journal.
  if ! available="$(cd "$WS_DIR" && colcon list --names-only)"; then
    log "colcon list failed in $WS_DIR at ${sha:0:12} (see stderr above)"
    return 1
  fi
  if [ -z "$available" ]; then
    log "colcon discovered no packages at ${sha:0:12}; that is a colcon fault, not an empty tree"
    return 1
  fi
  selected=""
  for p in $pkgs; do
    if printf '%s\n' "$available" | grep -qx "$p"; then
      selected="$selected $p"
    else
      log "package $p does not exist at ${sha:0:12}; dropping it from this build"
    fi
  done
  if [ -z "${selected# }" ]; then
    log "none of the requested packages exist at ${sha:0:12}"
    return 1
  fi

  ( cd "$WS_DIR" \
      && timeout "$BUILD_TIMEOUT_SECONDS" \
           colcon build --packages-select $selected --symlink-install --executor sequential ) \
    || return 1

  if [ "$units_changed" = 1 ]; then
    # Allowlisted in /etc/sudoers.d/beast-ops; the installer daemon-reloads.
    sudo -n /usr/local/sbin/beast-install-systemd-units || return 1
  fi

  # Workspace is consistent again (built, even if not yet verified) — release
  # the boot guard before asking systemd to start into it.
  rm -f "$IN_PROGRESS"

  # These verbs are already in /etc/sudoers.d/beast-ops; no new grant needed.
  # beast-nav is deliberately NOT restarted here — see the stop above.
  sudo -n /usr/local/sbin/beast-ctl restart beast-ros-base || return 1
  if [ "$cockpit_active" = 1 ]; then
    # restart, not try-restart: WE stopped it above, so try-restart on the now
    # stopped unit would silently never bring the cockpit back.
    sudo -n /usr/local/sbin/beast-ctl restart beast-cockpit || return 1
  fi
  sleep 20
}

write_state() {
  printf '{"sha":"%s","packages":"%s","verify":"%s","at":"%s"}\n' \
    "$1" "$2" "$3" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$STATE_FILE"
}

# colcon health is a PREcondition, not something to discover with the stack
# already stopped and the marker written: a broken colcon fails the forward
# build and the rollback's identical discovery the same way, and that double
# failure is the permanent self-hold with the stack down. Probe it while
# everything still runs — abort here and nothing has been touched.
( cd "$WS_DIR" && colcon list --names-only >/dev/null 2>&1 ) \
  || die "colcon cannot enumerate packages in $WS_DIR; aborting before touching the stack"

# Probed ONCE for the whole session (forward and rollback legs both read it);
# see the comment inside checkout_build_restart for why re-probing is a bug.
cockpit_active=0
systemctl is-active --quiet beast-cockpit && cockpit_active=1

if ! checkout_build_restart "$target" "$packages"; then
  log "checkout/build/restart failed for ${target:0:12}; rolling back"
  verify_result="deploy-failed"
else
  log "restarted on ${target:0:12}; verifying"
  if bash "$SESSION_VERIFY"; then
    log "OK deployed and verified ${target:0:12}"
    write_state "$target" "$packages" "pass"
    rm -f "$RECOVERY_COUNT" "$FAILED_TARGET"
    exit 0
  fi
  log "verification FAILED on ${target:0:12}; rolling back"
  verify_result="verify-failed"
fi

# ------------------------------------------------------------ rollback ----
# Rebuild the same package set on the way back (filtered against the rollback
# tree inside checkout_build_restart): the forward build already overwrote
# those artefacts, so restoring the checkout alone is not enough.
if checkout_build_restart "$rollback_sha" "$packages" && bash "$SESSION_VERIFY"; then
  log "rolled back to ${rollback_sha:0:12} and verified"
  write_state "$rollback_sha" "$packages" "rolled-back-from-${target:0:12}"
  # Remember the failed target so the next tick does not redeploy the same
  # bad commit and take the stack down twice an hour indefinitely.
  printf '%s\n' "$target" > "$FAILED_TARGET"
  rm -f "$RECOVERY_COUNT"
  exit 1
fi

# Neither version verifies. Stop trying: a robot that cannot verify either
# commit must not keep restarting itself once an hour unattended. If the last
# failure was mid-build, the in-progress marker is still present and
# beast-deploy-guard keeps the stack parked — stopped and loud, by design.
: > "$SELF_HOLD"
printf '%s\n' "$target" > "$FAILED_TARGET"
write_state "$rollback_sha" "$packages" "rollback-failed-held"
log "FAIL rollback to ${rollback_sha:0:12} also failed to verify ($verify_result on the way in)."
if [ -e "$IN_PROGRESS" ]; then
  log "Set $SELF_HOLD; the in-progress marker remains and beast-deploy-guard keeps the stack down."
  log "Investigate, then remove both $SELF_HOLD and $IN_PROGRESS."
else
  log "Set $SELF_HOLD; automatic deploys are stopped until a human clears it."
fi
exit 1
