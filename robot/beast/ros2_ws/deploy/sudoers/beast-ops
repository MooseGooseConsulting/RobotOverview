# BEAST-01 scoped passwordless sudo for user `beast`.
# Installed to /etc/sudoers.d/beast-ops (mode 0440). Validate: visudo -cf …
# Intentionally NOT NOPASSWD:ALL — only the ops agents/scripts already automate.
# Doppler BEAST_JETSON_ADMIN_PASSWORD remains break-glass / bootstrap only.
#
# Unit operations go through /usr/local/sbin/beast-ctl, NOT through a
# systemctl allowlist. sudoers matches the entire command line literally, so
# expressing per-unit policy here cost 193 lines of (verb x unit x .service x
# flag) and was still full of holes — `is-enabled beast-wifi-telemetry.timer`
# was refused while `enable` on the same unit was allowed, and `list-timers X`
# needed a second entry just to also permit `--no-pager`. The policy now lives
# in beast-ctl's table where it is greppable, reviewable, and unit-tested by
# tools/ci/test_beast_ctl.py. beast-ctl default-denies: unknown verb, unknown
# unit, or unknown flag exits 2 with no passthrough path.
#
# The wildcard below is safe ONLY because beast-ctl validates every argument
# itself and execs systemctl with an explicit argv array. It is also why
# beast-ctl must live in root-owned /usr/local/sbin and never be run from the
# repo checkout — /home/beast is writable by `beast`, so allowlisting a path
# under it would be a trivial root escalation.

Cmnd_Alias BEAST_CTL = /usr/local/sbin/beast-ctl *

# daemon-reload takes no unit, so it has no place in beast-ctl's table.
Cmnd_Alias BEAST_DAEMON_RELOAD = /usr/bin/systemctl daemon-reload

Cmnd_Alias BEAST_TAILSCALE = /usr/bin/tailscale serve *

Cmnd_Alias BEAST_INSTALL_UNITS = /usr/local/sbin/beast-install-systemd-units

Cmnd_Alias BEAST_LINGER = /usr/bin/loginctl enable-linger beast

Cmnd_Alias BEAST_REBOOT = /usr/sbin/reboot, /sbin/reboot, /usr/bin/systemctl reboot

beast ALL=(root) NOPASSWD: BEAST_CTL, BEAST_DAEMON_RELOAD, BEAST_TAILSCALE, BEAST_INSTALL_UNITS, BEAST_LINGER, BEAST_REBOOT
